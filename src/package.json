{
  "name": "roocode-lsp-tools",
  "version": "0.1.0",
  "description": "Custom LSP tools for Roo-Code plugin",
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["roo-code", "lsp", "vscode", "tools"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@roo-code/types": "^1.115.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.20.0",
    "glob": "^10.3.0"
  }
}
